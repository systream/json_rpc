{deps, []}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [json_rpc]}
]}.

{erl_opts, [warn_unused_vars, warn_shadow_vars, warn_unused_import, warn_obsolete_guard, debug_info]}.
{xref_checks, [undefined_function_calls, undefined_functions,
    locals_not_used, deprecated_function_calls,
    deprecated_functions]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{project_plugins, [rebar3_proper, rebar3_lint]}.

{minimum_otp_vsn, "28"}.

{profiles,
    [{test, [
        {deps, [
            {proper, {git, "https://github.com/proper-testing/proper.git", {tag, "master"}}},
            meck
        ]}
    ]}
    ]}.

{alias, [{test, [
    {ct, "--sname ct --cover true --readable true"},
    {proper, "--cover=true -n 512"},
    dialyzer]}
]}.

{dialyzer, [
    {warnings, [no_unknown]}
]}.

{elvis,
    [{config,
        [#{files => ["src/*.erl"],
           ruleset => erl_files
          },
         #{files => ["rebar.config"],
           ruleset => rebar_config
          }
        ]
     }
    ]
}.